source "https://rubygems.org"

# 로컬 개발용: GitHub Pages와 호환되는 Jekyll 3.x 사용
# GitHub Pages는 Jekyll 3.x를 사용하므로 로컬도 동일 버전으로 맞춤
gem "jekyll", "~> 3.9"
gem "jekyll-remote-theme", "~> 0.4.3"
gem "jekyll-paginate"
gem "jekyll-sitemap"
gem "jekyll-gist"
gem "jekyll-feed"
gem "jekyll-include-cache"
gem "kramdown-parser-gfm"  # GFM (GitHub Flavored Markdown) 지원

# GitHub Pages 배포용 (주석 처리 - 로컬 개발 시에는 사용하지 않음)
# 로컬에서 github-pages gem 설치 시 Ruby 버전 호환성 문제가 있을 수 있습니다
# gem "github-pages", group: :jekyll_plugins
