source "https://rubygems.org"

# 로컬 개발용: 최신 Jekyll과 필요한 플러그인만 사용
# GitHub Pages 배포 시에는 github-pages gem이 자동으로 jekyll-remote-theme를 지원합니다
gem "jekyll", "~> 4.3"
gem "jekyll-remote-theme", "~> 0.4.3"  # 최신 버전으로 명시
gem "jekyll-paginate"
gem "jekyll-sitemap"
gem "jekyll-gist"
gem "jekyll-feed"
gem "jekyll-include-cache"

# GitHub Pages 배포용 (주석 처리 - 로컬 개발 시에는 사용하지 않음)
# 로컬에서 github-pages gem 설치 시 Ruby 버전 호환성 문제가 있을 수 있습니다
# gem "github-pages", group: :jekyll_plugins
